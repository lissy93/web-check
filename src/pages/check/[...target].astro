---
import ResultsLayout from '@layouts/Results.astro';
import { normalizeAddress } from '../../client/utils/address-type-checker';
import { isCategory } from '@/data/categories';

export const prerender = false;

const { searchParams } = new URL(Astro.request.url);

// Forward ?url= links, and their optional ?category=, to the matching results page
const searchUrl = normalizeAddress(searchParams.get('url') || '');
const searchCategory = searchParams.get('category') || '';
const redirectPath =
  searchUrl && `/${isCategory(searchCategory) ? searchCategory : 'check'}/${searchUrl}`;

if (redirectPath) return Astro.redirect(redirectPath);

const { target } = Astro.params;
const pageTitle = target ? `${target} | Web Check` : 'Web Check';
---

<ResultsLayout title={pageTitle} />

<script>
  import { normalizeAddress } from '../../client/utils/address-type-checker';

  const form = document.querySelector<HTMLFormElement>('form');
  if (form) {
    form.addEventListener('submit', function (event: Event) {
      event.preventDefault();
      const input = (this as HTMLFormElement).querySelector<HTMLInputElement>('input[name="url"]');
      const target = normalizeAddress(input?.value);
      if (target) window.location.href = `/check/${target}`;
    });
  }
</script>
